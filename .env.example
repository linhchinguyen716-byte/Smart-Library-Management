# ==============================================================================
# Smart Library Management — Environment Configuration Template
# Sao chép tệp này thành .env để tùy chỉnh môi trường chạy thực tế:
# ==============================================================================

# Khóa bí mật ký phiên Flask (Bắt buộc đổi khóa ngẫu nhiên khi chạy production)
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars

# Chế độ gỡ lỗi (1: Bật debug / tự reload code khi sửa; 0: Tắt)
FLASK_DEBUG=0

# Cổng khởi chạy máy chủ backend Flask
PORT=5001

# Đường dẫn tệp cơ sở dữ liệu SQLite (mặc định tệp library.db tại thư mục gốc)
# DB_PATH=library.db

# Mật khẩu khởi tạo tài khoản quản trị viên đầu tiên (chỉ áp dụng khi tạo mới database)
# INITIAL_ADMIN_PASSWORD=AdminStrongPassword2026!
